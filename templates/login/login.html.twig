{% extends 'base.html.twig' %}

{% set body_class = 'login-page' %}

{% block title %}Connexion{% endblock %}

{% block meta %}
    <meta name="description" content="Connectez-vous à votre espace personnel sur le site Miss Pin-Up Bretagne.">
{% endblock %}

{% block body %}

    <section class="auth-page" role="main">

        <a class="auth-back" href="{{ path('app_home') }}">
            <i class="fa-solid fa-arrow-left"></i>
            Retour à l'accueil
        </a>

        <div class="auth-card">

            <h1>Connexion</h1>
            <p class="auth-subtitle">Accédez à votre espace personnel.</p>

            {% for message in app.flashes('verify_banner') %}
                <div class="auth-alert auth-alert--success">{{ message }}</div>
            {% endfor %}

            {% if error %}
                <div class="auth-alert auth-alert--error" role="alert" aria-live="assertive">
                    {% if error.messageKey == 'Veuillez confirmer votre e-mail avant de vous connecter.' %}
                        {{ error.messageKey }}
                        <a href="{{ path('app_resend_verification') }}?email={{ last_username }}" class="auth-link">
                            Renvoyer le lien de confirmation
                        </a>
                    {% else %}
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    {% endif %}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="auth-alert auth-alert--info">
                    Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
                    <a class="auth-link" href="{{ path('app_logout') }}">Se déconnecter</a>
                </div>
            {% endif %}

            <form method="post" class="auth-form">

                <div class="auth-field">
                    <label for="username">Email</label>
                    <input type="email"
                           id="username"
                           name="_username"
                           value="{{ last_username }}"
                           placeholder="vous@exemple.fr"
                           autocomplete="email"
                           required
                           autofocus>
                </div>

                <div class="auth-field">
                    <label for="password">Mot de passe</label>
                    <div class="auth-password">
                        <input type="password"
                               id="password"
                               name="_password"
                               placeholder="Votre mot de passe"
                               autocomplete="current-password"
                               required>
                        <button type="button" class="auth-password__toggle" aria-label="Afficher / masquer le mot de passe" onclick="togglePassword(this)">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <label class="auth-checkbox">
                    <input type="checkbox" name="_remember_me" id="_remember_me">
                    <span>Se souvenir de moi</span>
                </label>

                <button type="submit" class="auth-btn auth-btn--primary">
                    Se connecter
                </button>

            </form>

            <div class="auth-links">
                <a href="{{ path('app_register') }}">Pas encore de compte ? <strong>Inscrivez-vous</strong></a>
                <a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>
            </div>

        </div>

    </section>

    <script>
        function togglePassword(btn) {
            const input = btn.parentElement.querySelector('input');
            const icon = btn.querySelector('i');
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("fa-eye", "fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("fa-eye-slash", "fa-eye");
            }
        }
    </script>

{% endblock %}
