{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block meta %}
    <meta name="description" content="Contactez le comité Miss Pin-up Bretagne pour toute question ou information.
    Nous sommes là pour vous aider et répondre à vos demandes concernant nos événements, inscriptions et activités.">
{% endblock %}

{% block body %}

    <section class="contact-page">

        <div class="contact-hero">
            <img src="{{ asset('images/mail.png') }}" alt="" class="contact-hero__img">
        </div>

        <div class="contact-card">

            <h1>Contactez-nous</h1>
            <p class="contact-subtitle">Une question, une suggestion, une candidature ? Écrivez-nous, nous vous répondons rapidement.</p>

            {% if confirmation %}
                <div class="contact-alert contact-alert--success">
                    {{ confirmation }}
                </div>
            {% endif %}

            {{ form_start(contactForm, {
                method: 'POST',
                attr: {
                    id: 'contact-form',
                    class: 'contact-form',
                    'data-recaptcha': 'v3',
                    'data-recaptcha-action': 'contact',
                    'data-recaptcha-sitekey': recaptcha_site_key
                }
            }) }}

                <div class="contact-field">
                    {{ form_label(contactForm.nom) }}
                    {{ form_widget(contactForm.nom) }}
                    {% for error in contactForm.nom.vars.errors %}
                        <p class="contact-error">{{ error.message }}</p>
                    {% endfor %}
                </div>

                <div class="contact-field">
                    {{ form_label(contactForm.email) }}
                    {{ form_widget(contactForm.email) }}
                    {% for error in contactForm.email.vars.errors %}
                        <p class="contact-error">{{ error.message }}</p>
                    {% endfor %}
                </div>

                <div class="contact-field">
                    {{ form_label(contactForm.message) }}
                    {{ form_widget(contactForm.message) }}
                    {% for error in contactForm.message.vars.errors %}
                        <p class="contact-error">{{ error.message }}</p>
                    {% endfor %}
                </div>

                {{ form_widget(contactForm.envoyer, { attr: { class: 'contact-btn contact-btn--primary' } }) }}

            {{ form_end(contactForm) }}

        </div>

    </section>

    <script src="https://www.google.com/recaptcha/api.js?render={{ recaptcha_site_key }}"></script>
    <script src="{{ asset('js/recaptcha-v3.js') }}" defer></script>

{% endblock %}
