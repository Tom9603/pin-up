{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}

    <section class="profil-page" role="main">

        <div class="profil-card">
            <h1>Modifier mon profil</h1>

            {{ form_start(profilForm) }}
                {{ form_row(profilForm.name) }}
                {{ form_row(profilForm.email) }}
                {{ form_row(profilForm.plainPassword) }}

                <button type="submit" class="profil-btn profil-btn--primary">
                    Mettre à jour
                </button>
            {{ form_end(profilForm) }}
        </div>

        <div class="profil-card">
            <h2>Mes commandes</h2>
            <p>Retrouvez l'historique de vos achats et téléchargez vos factures.</p>

            <a href="{{ path('app_profil_orders') }}" class="profil-btn">
                <i class="fa-solid fa-receipt"></i>
                Voir mes commandes
            </a>
        </div>

        <div class="profil-card profil-card--danger">
            <h2>
                <i class="fa-solid fa-triangle-exclamation"></i>
                Zone dangereuse
            </h2>
            <p>
                La suppression de votre compte est <strong>définitive</strong>.
                Toutes vos données (commandes, profil, etc.) seront effacées.
            </p>

            <form method="post" action="{{ path('app_profil_delete') }}" class="profil-delete-form">
                <label for="password">Confirmez votre mot de passe :</label>
                <input type="password" name="password" id="password" required placeholder="Votre mot de passe">

                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ app.user.id) }}">

                <button type="submit" class="profil-btn profil-btn--danger">
                    <i class="fa-solid fa-trash"></i>
                    Supprimer mon compte
                </button>
            </form>
        </div>

    </section>

{% endblock %}
