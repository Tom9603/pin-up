{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}

    <section class="auth-page" role="main">

        <div class="auth-card">

            <h1>Nouveau mot de passe</h1>
            <p class="auth-subtitle">
                Choisissez un nouveau mot de passe sécurisé pour votre compte.
            </p>

            {{ form_start(resetForm, {'attr': {'class': 'auth-form'}}) }}

                <div class="auth-field">
                    {{ form_label(resetForm.plainPassword) }}
                    {{ form_widget(resetForm.plainPassword) }}
                    {% for error in resetForm.plainPassword.vars.errors %}
                        <p class="auth-error">{{ error.message }}</p>
                    {% endfor %}
                </div>

                <button type="submit" class="auth-btn auth-btn--primary">
                    Valider
                </button>

            {{ form_end(resetForm) }}

        </div>

    </section>

{% endblock %}
