{% extends 'base.html.twig' %}

{% block title %}Événements{% endblock %}

{% block meta %}
    <meta name="description" content="Découvrez le calendrier des événements du comité Miss Pin-up Bretagne.
        Participez à l'espace blog, à nos activités festives, défilés et shootings vintage en Bretagne.
        Rejoignez-nous pour vivre des moments inoubliables dans l'univers rétro des pin-up.">
{% endblock %}

{% block body %}

    <h1>Calendrier des événements</h1>
    <h2 class="space">Calendrier événementiel</h2>

    <div class="events-page">
        <div id="calendar"></div>
    </div>

    <div id="modal" class="modal">
        <div class="modal-content">
            <ul id="reservationList"></ul>
            <div id="reservationMessage"></div>
            <button id="reserveBtn">S'inscrire</button>
            <button id="unreserveBtn">Se désinscrire</button>
            <button id="closeModal">Fermer</button>
        </div>
    </div>

    {% if upcomingEvents is not empty %}
        <section class="upcoming-events">
            <h2>Prochains événements</h2>

            <div class="upcoming-events__list">
                {% for event in upcomingEvents %}
                    {% set daysUntil = date(event.start).diff(date()).days %}
                    {% set eventType = event.eventType ?: 'autre' %}
                    {% set firstMedia = event.medias|first %}
                    {% set imageUrl = firstMedia ? asset('media/' ~ firstMedia.fileName) : null %}

                    <article class="upcoming-event-card"
                             data-event-id="{{ event.id }}"
                             data-event-title="{{ event.title }}"
                             data-event-start="{{ event.start|date('Y-m-d H:i:s') }}"
                             tabindex="0"
                             aria-label="Voir le détail de {{ event.title }}">

                        <div class="upcoming-event__header">
                            {% if imageUrl %}
                                <img class="upcoming-event__image"
                                     src="{{ imageUrl }}"
                                     alt="{{ event.title }}">
                            {% else %}
                                <div class="upcoming-event__image upcoming-event__image--placeholder">
                                    <span class="upcoming-event__day">{{ event.start|date('d') }}</span>
                                    <span class="upcoming-event__month">{{ event.start|format_date(locale='fr', pattern='MMM')|upper|trim('.') }}</span>
                                </div>
                            {% endif %}

                            <div class="upcoming-event__info">
                                <h3 class="upcoming-event__title">{{ event.title }}</h3>
                                <p class="upcoming-event__meta">
                                    {{ event.start|format_date(locale='fr', pattern='EEEE d MMMM y')|capitalize }}
                                    {% if event.location %} · {{ event.location }}{% endif %}
                                </p>
                                {% if event.eventType %}
                                    <span class="upcoming-event__badge upcoming-event__badge--{{ eventType }}">
                                        {{ eventType }}
                                    </span>
                                {% endif %}
                            </div>

                            <span class="upcoming-event__countdown">
                                {% if daysUntil == 0 %}
                                    Aujourd'hui
                                {% elseif daysUntil == 1 %}
                                    Demain
                                {% else %}
                                    Dans {{ daysUntil }} j.
                                {% endif %}
                            </span>
                        </div>

                        <div class="upcoming-event__details">
                            {% if event.content %}
                                <div class="upcoming-event__description">
                                    {{ event.content|sanitize_html }}
                                </div>
                            {% endif %}

                            {% if event.medias|length > 1 %}
                                <div class="upcoming-event__gallery">
                                    {% for media in event.medias %}
                                        <img src="{{ asset('media/' ~ media.fileName) }}"
                                             alt="{{ event.title }}">
                                    {% endfor %}
                                </div>
                            {% endif %}

                            <button type="button" class="upcoming-event__reserve">
                                S'inscrire à l'événement
                            </button>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <section class="blog-section">
        <h2>Nos actualités</h2>
        <div class="category-tabs">
            {% for category in categories %}
                <button class="tab-btn" data-id="{{ category.id }}">{{ category.name|upper }}</button>
            {% endfor %}
        </div>

        <div class="articles-container">
            {% for category in categories %}
                <div class="articles-list" id="cat-{{ category.id }}" style="display: none;">
                    {% for article in category.articles %}
                        <article class="article-card" data-id="{{ article.id }}">
                            <h3 class="article-title">{{ article.title|upper }}</h3>
                            <p class="category-name">Catégorie : {{ category.name }}</p>
                            <p class="toggle-text"></p>

                            <div class="article-content">
                                {{ article.content|sanitize_html }}
                                {% if article.medias|length > 0 %}
                                    <div class="article-images">
                                        {% for media in article.medias %}
                                            <img src="{{ asset('media/' ~ media.fileName) }}" alt="{{ article.title }}" class="article-image">
                                        {% endfor %}
                                    </div>
                                {% endif %}

                                <div class="comments">
                                    <h4>Commentaires</h4>
                                    {% if article.comments|length > 0 %}
                                        {% for comment in article.comments %}
                                            <div class="comment">
                                                <strong>{{ comment.user ? comment.user.name : 'Anonyme' }}</strong>
                                                <small>– {{ comment.dateComment|date('d/m/Y') }}</small>
                                                <p>{{ comment.content }}</p>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <p>Aucun commentaire pour le moment.</p>
                                    {% endif %}
                                </div>

                                {% if app.user %}
                                    <form action="{{ path('comment_add', {'articleId': article.id}) }}" method="POST" class="comment-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('comment_add_' ~ article.id) }}">
                                        <textarea name="content" placeholder="Votre commentaire..." required></textarea>
                                        <button type="submit">Envoyer</button>
                                    </form>
                                {% else %}
                                    <p class="login-notice">
                                        <a href="{{ path('app_login') }}">Connectez-vous</a> pour laisser un commentaire.
                                    </p>
                                {% endif %}
                            </div>
                        </article>

                    {% else %}
                        <p class="no-article">Aucun article dans cette catégorie.</p>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    </section>

    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

    <script>
        const IS_LOGGED_IN = {{ app.user ? 'true' : 'false' }};
        const LOGIN_URL = "{{ path('app_login') }}";
        const USERNAME = "{{ app.user ? app.user.name : '' }}";
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.upcoming-event-card').forEach((card) => {
                const toggle = () => card.classList.toggle('open');

                card.addEventListener('click', (e) => {
                    // Ne pas toggle si le clic est sur un bouton/lien/img interne
                    if (e.target.closest('button, a')) return;
                    toggle();
                });

                card.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        toggle();
                    }
                });

                const reserveBtn = card.querySelector('.upcoming-event__reserve');
                if (reserveBtn) {
                    reserveBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        if (!IS_LOGGED_IN) {
                            window.location.href = LOGIN_URL;
                            return;
                        }
                        if (typeof window.openReservationModal === 'function') {
                            window.openReservationModal(
                                card.dataset.eventId,
                                card.dataset.eventTitle,
                                card.dataset.eventStart
                            );
                        }
                    });
                }
            });
        });
    </script>

{% endblock %}
