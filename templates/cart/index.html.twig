{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}

    <section class="cart-container">

        <h1>Mon panier</h1>

        <a class="cart-back" href="{{ path('app_shop') }}">
            <i class="fa-solid fa-arrow-left"></i>
            Continuer mes achats
        </a>

        {% if products is empty %}
            <p>Votre panier est vide.</p>

            <p>
                <a class="cart-btn cart-btn--primary" href="{{ path('app_shop') }}">Voir la boutique</a>
            </p>

        {% else %}

            <ul class="cart-list">
                {% for product in products %}
                    <li class="cart-item">

                        {% if product.imageName %}
                            <img class="cart-item__image"
                                 src="{{ asset('uploads/images/' ~ product.imageName) }}"
                                 alt="{{ product.name }}">
                        {% else %}
                            <div class="cart-item__image cart-item__image--empty"></div>
                        {% endif %}

                        <div class="cart-item__body">

                            <div class="cart-item__title">{{ product.name }}</div>

                            <div class="cart-row">
                                <span>Quantité</span>

                                <span class="cart-qty">
                                    <form method="post" action="{{ path('cart_update', { id: product.id, action: 'minus' }) }}" data-preserve-scroll>
                                        <input type="hidden" name="_token" value="{{ csrf_token('cart_update') }}">
                                        <button type="submit" class="cart-qty__btn">−</button>
                                    </form>
                                    <span class="cart-qty__value">{{ cart[product.id] }}</span>
                                    <form method="post" action="{{ path('cart_update', { id: product.id, action: 'plus' }) }}" data-preserve-scroll>
                                        <input type="hidden" name="_token" value="{{ csrf_token('cart_update') }}">
                                        <button type="submit" class="cart-qty__btn">+</button>
                                    </form>
                                </span>
                            </div>

                            <div class="cart-row">
                                <span>Prix unitaire</span>
                                <strong>{{ (product.price / 100)|number_format(2, ',', ' ') }} €</strong>
                            </div>

                            <div class="cart-row">
                                <span>Sous-total</span>
                                <strong>{{ ((product.price * cart[product.id]) / 100)|number_format(2, ',', ' ') }} €</strong>
                            </div>

                            <div class="cart-item__actions">
                                <form method="post" action="{{ path('cart_remove', { id: product.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_remove') }}">
                                    <button type="submit" class="cart-remove">
                                        <i class="fa-solid fa-trash"></i>
                                        Supprimer
                                    </button>
                                </form>
                            </div>

                        </div>

                    </li>
                {% endfor %}
            </ul>

            <p class="cart-total">
                <span>Total</span>
                <strong>{{ (total / 100)|number_format(2, ',', ' ') }} €</strong>
            </p>

            <div class="cart-actions">
                <form method="post" action="{{ path('cart_checkout') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart_checkout') }}">
                    <button type="submit" class="cart-btn cart-btn--primary">Valider et payer</button>
                </form>

                <form method="post" action="{{ path('cart_clear') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart_clear') }}">
                    <button type="submit" class="cart-btn cart-btn--danger">Vider le panier</button>
                </form>
            </div>

        {% endif %}

    </section>

{% endblock %}
